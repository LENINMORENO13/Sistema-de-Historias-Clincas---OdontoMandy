# --------------------------------------------------------------------
# 1. SEGURIDAD Y ENTORNO 
# --------------------------------------------------------------------
.env
.env.boot
.env.test
/app/Config/development/
/app/Config/testing/

# --------------------------------------------------------------------
# 2. DEPENDENCIAS (Composer y NPM)
# --------------------------------------------------------------------
/vendor/
/node_modules/
# ¡OJO! Comentamos estos dos para que SÍ se suban y mantengan versiones:
# composer.lock
# package-lock.json

# --------------------------------------------------------------------
# 3. CODEIGNITER 4 - CARPETA WRITABLE (Temporales)
# --------------------------------------------------------------------
# Ignorar contenido pero MANTENER la estructura de carpetas
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

/writable/debugbar/*
!/writable/debugbar/.gitkeep

# --------------------------------------------------------------------
# 4. IDEs Y SISTEMA OPERATIVO
# --------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --------------------------------------------------------------------
# 5. ARCHIVOS TEMPORALES Y LOGS GENERALES
# --------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*.user
php_errors.log

# --------------------------------------------------------------------
# 6. BASE DE DATOS
# --------------------------------------------------------------------
*.sql
*.sqlite
*.db
!database/schema.sql  <-- Si tienes tu script de instalación aquí, esto permite subirlo.

# --------------------------------------------------------------------
# 7. TESTING
# --------------------------------------------------------------------
/tests/_support/_generated/
phpunit.xml
# Mantenemos phpunit.xml.dist como plantilla

!Img/